# ── App ──────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
AUTH_SECRET=your-secret-here-min-32-chars
NEXTAUTH_SECRET=your-secret-here-min-32-chars

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://cliniq:cliniq_secret@localhost:5432/cliniq_db
POSTGRES_USER=cliniq
POSTGRES_PASSWORD=cliniq_secret
POSTGRES_DB=cliniq_db

# ── Redis ─────────────────────────────────────────────
REDIS_URL=redis://:redis_secret@localhost:6379
REDIS_PASSWORD=redis_secret

# ── WhatsApp (Evolution API) ──────────────────────────
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=your-evolution-api-key

# ── AI ────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=                # optional fallback

# ── N8N ──────────────────────────────────────────────
N8N_WEBHOOK_URL=http://localhost:5678
N8N_HOST=localhost
N8N_ENCRYPTION_KEY=your-32-char-encryption-key

# ── Payments ─────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
PAGARME_API_KEY=                # for PIX

# ── Email ─────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@cliniq.com.br

# ── Storage ──────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=cliniq-uploads
